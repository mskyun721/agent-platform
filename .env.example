# agent-platform 로컬 설정. 복사해서 쓴다:  cp .env.example .env
# .env 는 git 에 올리지 않는다. 프로세스 환경 변수가 있으면 그 값이 우선한다.

# [필수] MCP/CLI 가 읽고 쓸 수 있는 대상 프로젝트의 상위 경로. 여러 개는 ':' 로 구분.
# 플랫폼 자신의 경로는 항상 허용되므로 적지 않는다.
AGENT_PLATFORM_ALLOWED_PROJECT_ROOTS="/path/to/projects:/path/to/another-project-root"

# 대상 프로젝트는 여기서 정하지 않는다.
#   .active-project 에 절대경로를 한 줄씩 적는다. 첫 줄이 기본 타겟.
#   기본 전환: `agent-platform-agent project-use <폴더명|등록 ID>` / 요청별: --root <폴더명|등록 ID|경로>

# [선택] Confluence 동기화 (confluence_* 도구를 쓸 때만)
# CONFLUENCE_URL="https://your-domain.atlassian.net/wiki"
# CONFLUENCE_EMAIL="you@example.com"
# CONFLUENCE_API_TOKEN=""

# [선택] Apidog 연동 (apidog_* 도구를 쓸 때만)
# APIDOG_API_TOKEN=""

# [선택] 실행 관측 DB 위치. 기본값은 .local/state.db
# AGENT_PLATFORM_STATE_DB=""

# [선택] Notion 게시 (notion_sync_feature / publish_feature target=notion 에서만)
#   integration secret(ntn_… 또는 secret_…). 부모 페이지 ID 는 env 가 아니라
#   `agent-platform-agent project-publish-set <id> --target notion --notion-parent-page-id <ID>` 로 정한다.
# NOTION_TOKEN=""
