# agent-platform 로컬 설정. 복사해서 쓴다:  cp .env.example .env
# .env 는 git 에 올리지 않는다. 프로세스 환경 변수가 있으면 그 값이 우선한다.

# 이 파일에는 연동 토큰 같은 비밀값만 둔다. 프로젝트 설정은 .agent-projects.json 하나에 있다.
#   workspace(쓰기 허용 상위 폴더): `agent-platform-agent project-workspace add <dir>`
#   대상 프로젝트 등록·기본 타겟:   `agent-platform-agent project-add <경로|git URL> [--default]`
#   기본 전환: `project-use <등록 ID|폴더명>` / 요청별: --root <등록 ID|폴더명|경로>
# deprecated: AGENT_PLATFORM_ALLOWED_PROJECT_ROOTS 는 `project-workspace add` 로 옮겨졌다.
#   남아 있으면 레지스트리에 workspace 가 없을 때만 fallback 으로 쓰인다.
#   `agent-platform-agent project-migrate` 로 옮긴 뒤 .env 에서 그 줄을 지운다.

# [선택] Confluence 동기화 (confluence_* 도구를 쓸 때만)
# CONFLUENCE_URL="https://your-domain.atlassian.net"   # /wiki 는 붙이지 않는다(도구가 추가)
# CONFLUENCE_EMAIL="you@example.com"
# CONFLUENCE_API_TOKEN=""

# [선택] Apidog 연동 (apidog_* 도구를 쓸 때만)
# APIDOG_API_TOKEN=""

# [선택] 실행 관측 DB 위치. 기본값은 .local/state.db
# AGENT_PLATFORM_STATE_DB=""

# [선택] Notion 게시 (notion_sync_feature / publish_feature target=notion 에서만)
#   integration secret(ntn_… 또는 secret_…). 부모 페이지 ID 는 env 가 아니라
#   `agent-platform-agent project-publish-set <id> --target notion --notion-parent-page-id <ID>` 로 정한다.
# NOTION_TOKEN=""
