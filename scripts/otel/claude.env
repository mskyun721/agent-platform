# source scripts/otel/claude.env   (or put the same keys under "env" in ~/.claude/settings.json)
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json
export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# traces (beta): span tree interaction → llm_request → tool
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_TRACES_EXPORTER=otlp
# content stays redacted (do NOT set OTEL_LOG_USER_PROMPTS / OTEL_LOG_ASSISTANT_RESPONSES / OTEL_LOG_TOOL_CONTENT)
export OTEL_METRICS_INCLUDE_SESSION_ID=true
export OTEL_RESOURCE_ATTRIBUTES=service.namespace=agent-platform
