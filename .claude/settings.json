{
  "permissions": {
    "allow": [
      "Bash(mkdir *)",
      "mcp__agent-platform__hello",
      "mcp__agent-platform__plan_run",
      "mcp__agent-platform__feature_scaffold",
      "mcp__agent-platform__feature_list_artifacts",
      "mcp__agent-platform__feature_gate_check",
      "mcp__agent-platform__handoff_validate",
      "mcp__agent-platform__standards_read",
      "mcp__agent-platform__standards_list",
      "mcp__agent-platform__review_run",
      "mcp__agent-platform__audit_run",
      "mcp__agent-platform__qa_run",
      "mcp__agent-platform__release_run",
      "mcp__agent-platform__project_init"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/platform_hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/platform_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/platform_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/platform_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
